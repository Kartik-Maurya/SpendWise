# SpendWise v3.0.0 — Environment Configuration
# Copy this file to server/.env and fill in real values:
#   cp .env.example server/.env
# NEVER commit server/.env to version control. Full walkthrough: SETUP.md

# Server
PORT=5000
NODE_ENV=development

# Allowed frontend origin (CORS). Change together with PORT if you move the API.
CORS_ORIGIN=http://localhost:3000

# Session secret (used to sign session cookies). Required in production.
# Generate a strong random value, e.g.:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=change-me-to-a-strong-random-string

# Encryption key for AES-256-GCM (32 bytes encoded as 64 hex characters).
# Required in production. Replace the placeholder below with a real key:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Changing this without keeping the old value in ENCRYPTION_KEY_PREVIOUS makes
# existing descriptions unreadable.
ENCRYPTION_KEY=replace-with-64-hex-characters-generated-locally

# Older keys that may still decrypt existing records (comma separated).
# Only needed while rotating: set the new key above and the old key(s) here,
# run server/scripts/reencrypt.js, then remove this line.
# ENCRYPTION_KEY_PREVIOUS=

# Public URL used in password-reset links (defaults to CORS_ORIGIN, then localhost:3000)
# APP_URL=http://localhost:3000

# Optional SMTP for password-reset email. Without SMTP_HOST the reset link is
# printed to the server console instead (development fallback).
# Gmail example (requires 2-Step Verification and an App Password — see SETUP.md):
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=your.address@gmail.com
# SMTP_PASS=your-16-character-app-password
# MAIL_FROM=SpendWise <your.address@gmail.com>

# Optional database override (used by scripts and isolated test runs)
# SPENDWISE_DB_PATH=./server/database/spendwise.db
