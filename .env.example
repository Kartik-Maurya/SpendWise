# SpendWise v2.0.0 — Environment Configuration
# Copy this file to .env and fill in real values.
# NEVER commit the .env file to version control.

# Server
PORT=5000
NODE_ENV=development

# Session secret (used to sign session cookies)
# Generate a strong random value, e.g.: openssl rand -base64 48
SESSION_SECRET=change-me-to-a-strong-random-string

# Encryption key for AES-256-GCM (must be a 32-byte key, encoded as hex or base64)
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# Frontend (Vite proxy target, usually matches the server port)
VITE_API_BASE=/api
